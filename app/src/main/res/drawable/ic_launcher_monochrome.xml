<?xml version="1.0" encoding="utf-8"?>
<!-- Article/newspaper glyph on a 1.5-unit stroke grid: every element, including
     the image box, uses the same stroke; the rows are 2.75 apart so all gaps are
     1.25; the content has equal padding inside the frame; and the frame stays
     inside the 66dp adaptive icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group android:scaleX="2.2"
        android:scaleY="2.2"
        android:translateX="54"
        android:translateY="54">
        <!-- newspaper outer shape -->
        <path
            android:pathData="M-8.75,-9.75L8.75,-9.75A2,2 0,0 1,10.75 -7.75L10.75,7.75A2,2 0,0 1,8.75 9.75L-8.75,9.75A2,2 0,0 1,-10.75 7.75L-10.75,-7.75A2,2 0,0 1,-8.75 -9.75z"
            android:strokeColor="#000000"
            android:strokeWidth="1.5"
            android:fillColor="@android:color/transparent"/>

        <!-- image box, spanning the first three rows -->
        <path
            android:pathData="M-5.5,-5.5L-2,-5.5A1,1 0,0 1,-1 -4.5L-1,-1A1,1 0,0 1,-2 0L-5.5,0A1,1 0,0 1,-6.5 -1L-6.5,-4.5A1,1 0,0 1,-5.5 -5.5z"
            android:strokeColor="#000000"
            android:strokeWidth="1.5"
            android:fillColor="@android:color/transparent"/>

        <!-- headline lines beside the image -->
        <path
            android:pathData="M1.75,-5.5L6.5,-5.5"
            android:strokeColor="#000000"
            android:strokeWidth="1.5"
            android:strokeLineCap="round"/>

        <path
            android:pathData="M1.75,-2.75L6.5,-2.75"
            android:strokeColor="#000000"
            android:strokeWidth="1.5"
            android:strokeLineCap="round"/>

        <path
            android:pathData="M1.75,0L6.5,0"
            android:strokeColor="#000000"
            android:strokeWidth="1.5"
            android:strokeLineCap="round"/>

        <!-- text lines below the image -->
        <path
            android:pathData="M-6.5,2.75L6.5,2.75"
            android:strokeColor="#000000"
            android:strokeWidth="1.5"
            android:strokeLineCap="round"/>

        <path
            android:pathData="M-6.5,5.5L6.5,5.5"
            android:strokeColor="#000000"
            android:strokeWidth="1.5"
            android:strokeLineCap="round"/>
    </group>
</vector>
